{
  "name": "smart-web-server-webui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock",
    "dev:device": "vite --mode device",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:embed": "npm run typecheck && vite build --mode embed && node scripts/embed-assets.mjs",
    "preview": "vite preview",
    "lint:comments": "node scripts/check-comments.mjs",
    "postinstall": "msw init public --no-save",
    "build:mock": "npm run typecheck && vite build --mode mock",
    "test:e2e:mock": "npm run build:mock && playwright test --config playwright.mock.config.ts",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"e2e*/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"e2e*/**/*.ts\" \"*.{ts,json}\""
  },
  "dependencies": {
    "@lucide/vue": "1.49.0",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
