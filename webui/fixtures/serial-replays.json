{
  "schemaVersion": 1,
  "replyTerminator": "#",
  "scenarios": [
    {
      "id": "onstep-4.24-connected",
      "description": "OnStep 4.24 with one legacy focuser and a GEM mount",
      "transport": { "connected": true },
      "controller": { "protocolFamily": "onstep4", "version": "4.24x", "name": "OnStep" },
      "exchanges": [
        { "command": ":GVP#", "response": "On-Step#" },
        { "command": ":GVN#", "response": "4.24x#" },
        { "command": ":GVC#", "response": "Legacy_GEM#" },
        { "command": ":GU#", "response": "NTE000#" },
        { "command": ":FA#", "response": "1#" },
        { "command": ":fA#", "response": "0#" },
        { "command": ":GX98#", "response": "N#" },
        { "command": ":GXY0#", "response": "00000000#" },
        { "command": ":GX94#", "response": "1#" },
        { "command": ":A?#", "response": "909#" }
      ],
      "expected": {
        "safeReadOnly": false,
        "capabilities": {
          "mount": true,
          "rotator": false,
          "focuserCount": 1,
          "auxiliary": false,
          "axisCount": 2,
          "highPrecisionCoordinates": true,
          "axisConfiguration": false,
          "autoHome": false,
          "meridianFlipHomeModes": false,
          "workingSlewRate": false
        }
      }
    },
